---
import Catalog from "../../../components/Catalog.astro";
import { locales, type Locale } from "../../../lib/i18n";
import {
    CATALOG_STATUS_PAGES,
    type BookStatus,
} from "../../../lib/catalog";

export function getStaticPaths() {
    return locales.flatMap((lang) =>
        CATALOG_STATUS_PAGES.map((status) => ({
            params: { lang, status },
            props: { status },
        })),
    );
}

const locale = Astro.params.lang as Locale;
const { status } = Astro.props as { status: BookStatus };
---

<Catalog locale={locale} status={status} />
